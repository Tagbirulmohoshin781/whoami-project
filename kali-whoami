#!/bin/bash
# Whoami | Enhanced Privacy and Anonymity for Linux

# Check source files (installed directory or relative local repo)
if [ -f "/usr/share/kali-whoami/assets/sources/config" ]; then
    source "/usr/share/kali-whoami/assets/sources/config"
else
    _ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    if [ -f "$_ROOT_DIR/assets/sources/config" ]; then
        source "$_ROOT_DIR/assets/sources/config"
    else
        clear
        echo -e "\e[31m[-] FATAL ERROR: MAIN CONFIG COULD NOT BE SOURCED!\e[0m"
        echo -e "Make sure the tool is installed using: 'sudo make install'"
        exit 1
    fi
fi

require_root() {
    if [ "$EUID" -ne 0 ]; then
        err "Whoami must be run as root. ${GREEN}'sudo $(basename "${0}") [option]'${RESET}"
    fi
}

src_check() {
    local check_status="1"
    for script_name in "${@}"; do
        if [ -f "$SRCDIR/scripts/$script_name" ]; then
            source "$SRCDIR/scripts/$script_name"
        else
            warn "The source file could not be found: $script_name. Please re-install the tool."
            check_status="0"
        fi
    done
    if [ "${check_status}" = "0" ]; then
        err "Missing source files. Run:\n'${GREEN}git clone https://github.com/Tagbirulmohoshin781/whoami-project && cd whoami-project && sudo make reinstall${RESET}'"
    fi
}
src_check fix log_killer ip_changer dns_changer mac_changer anti_cold_boot hostname_changer timezone_changer browser_anonymization

# Check dependencies function
dep_check() {
    local check_status="1"
    for dep in "${@}"; do
        if [ "$dep" = "scapy" ]; then
            python3 -c "import scapy" &>/dev/null || { warn "Python library 'scapy' could not be found." ; check_status="0" ; }
        else
            command -v "$dep" &>/dev/null || { warn "Command '$dep' could not be found." ; check_status="0" ; }
        fi
    done
    if [ "${check_status}" = "0" ]; then
        err "Please install missing dependencies:\n'${GREEN}sudo apt update && sudo apt install tar tor curl python3 python3-scapy network-manager iptables${RESET}'"
    fi
}

start_anti_mitm(){
    python3 "$SRCDIR/scripts/anti_mitm" &
    local antimitmpid="$!"
    sed -i 's/anti_mitm_pid="0"/anti_mitm_pid="'$antimitmpid'"/g;s/anti_mitm_status="Disable"/anti_mitm_status="Enable"/g' "$SRCDIR/sources/config"
    info "Anti mitm successfully enabled"
}

stop_anti_mitm(){
    if [ -n "$anti_mitm_pid" ] && [ "$anti_mitm_pid" != "0" ]; then
        kill "$anti_mitm_pid" 2>/dev/null || true
    fi
    pkill -f "assets/scripts/anti_mitm" 2>/dev/null || true
    sed -i 's/anti_mitm_pid="[0-9]*"/anti_mitm_pid="0"/g;s/anti_mitm_status="Enable"/anti_mitm_status="Disable"/g' "$SRCDIR/sources/config"
    info "Anti mitm successfully disabled"
}

start(){

    require_root
    dep_check tar tor curl python3 scapy

    # Create safety backup if not already present
    if [ ! -f "$BACKUPDIR/whoami_fix_backups.tar.gz" ]; then
        get_backups
    fi

    local options=("Anti Mitm" "Log killer" "Ip changer" "Dns changer" "Mac changer" "Timezone changer" "Hostname changer" "Browser anonymization" "Anti cold boot")
    local choices=()
    local stat=""
    local num=""

    menu() {
        info "Available features:\n"
        for opt in "${!options[@]}"; do
            printf "[%s] %s\n" $((opt+1)) "${options[opt]} ${choices[opt]}"
        done
        [[ -n "$stat" ]] && msg "$stat"
        :
    }

    while banner && menu && input && read -r num && [[ -n "$num" ]]; do
        if [[ "$num" =~ ^[0-9]+$ ]] && (( num > 0 && num <= ${#options[@]} )); then
            ((num--))
            stat="${options[num]} was ${choices[num]:+un}checked"
            [[ -n "${choices[num]}" ]] && choices[num]="" || choices[num]="✓"
        elif [[ "$num" == "a" || "$num" == "A" ]]; then
            for opt in "${!options[@]}"; do
                choices[opt]="✓"
            done
            stat="All options selected"
        else
            stat="Invalid option: $num"
        fi
    done

    banner
    # Execute selected features
    for opt in "${!options[@]}"; do
        if [[ -n "${choices[opt]}" ]]; then
            local func_name="start_$(echo "${options[opt]}" | tr '[:upper:]' '[:lower:]' | tr ' ' '_' | sed 's/ı/i/g')"
            if declare -f "$func_name" >/dev/null; then
                "$func_name"
            fi
        fi
    done

}

stop(){

    require_root
    source "$SRCDIR/sources/config"

    if grep -q 'status="Enable"' "$SRCDIR/sources/config"; then

        local options=("anti_mitm" "ip_changer" "dns_changer" "mac_changer" "timezone_changer" "hostname_changer" "browser_anonymization")

        for opt in "${options[@]}"; do
            local status_var="${opt}_status"
            if [[ "${!status_var}" == "Enable" ]]; then
                local stop_func="stop_${opt}"
                if declare -f "$stop_func" >/dev/null; then
                    "$stop_func"
                fi
            fi
        done

    else
        err "No features are active. (Run to activate: '${GREEN}sudo kali-whoami --start${RESET}')"
    fi
}

status(){

    source "$SRCDIR/sources/config"

    local current_ip="N/A"
    if [ "$ip_changer_status" = "Enable" ]; then
        current_ip="$(curl -s --socks5 127.0.0.1:9050 --max-time 5 https://api.ipify.org 2>/dev/null || echo "Tor Active")"
    fi

    msg "Kali Whoami status:

 ${GREEN}Anti Mitm             :${RESET} $anti_mitm_status
 ${GREEN}Ip changer            :${RESET} $ip_changer_status $([ "$ip_changer_status" = "Enable" ] && echo "($current_ip)")
 ${GREEN}Dns changer           :${RESET} $dns_changer_status
 ${GREEN}Mac changer           :${RESET} $mac_changer_status
 ${GREEN}Timezone changer      :${RESET} $timezone_changer_status
 ${GREEN}Hostname changer      :${RESET} $hostname_changer_status ($(hostname 2>/dev/null))
 ${GREEN}Browser anonymization :${RESET} $browser_anonymization_status"

}

fix(){

    require_root
    if [ -f "$BACKUPDIR/whoami_fix_backups.tar.gz" ]; then
        restore_system
        msg "System successfully repaired and restored"
    else
        err "Whoami backup file not found ($BACKUPDIR/whoami_fix_backups.tar.gz)"
    fi
}

help() {

    msg "Usage : sudo kali-whoami ${GREEN}[option]${RESET}

 ${GREEN}--start, -s  :${RESET}   Make backups and start selected anonymity modules.
 ${GREEN}--stop,  -k  :${RESET}   Close all active modules and restore original settings.
 ${GREEN}--status,-t  :${RESET}   Display status of all modules and current IP.
 ${GREEN}--fix,   -f  :${RESET}   Restore the system from backup in case of network or configuration error.
 ${GREEN}--help,  -h  :${RESET}   Show this help menu."
}

main() {

    if [[ "$#" -eq 0 ]]; then
        warn "Whoami: Argument required"
        info "Run ${GREEN}'kali-whoami --help'${RESET} for more information."
        exit 1
    fi

    case "$1" in
        --[sS][tT][aA][rR][tT]|-[sS]|-[sS][tT])
            start   
            ;;
        --[sS][tT][oO][pP]|-[kK]|-[sS][pP])
            stop    
            ;;
        --[sS][tT][aA][tT][uU][sS]|-[tT]|-[sS][sS])
            status  
            ;;
        --[fF][iI][xX]|-[fF])
            fix  
            ;;
        --[hH][eE][lL][pP]|-[hH])
            help
            exit 0
            ;;
        *)
            warn "Whoami: Invalid option ${RED}'$1'${RESET}"
            info "Run ${GREEN}'kali-whoami --help'${RESET} for more information."
            exit 1
            ;;
    esac
}

# Trap SIGINT to exit cleanly
trap 'echo -e "\n${YELLOW}[!] Interrupted by user.${RESET}"; exit 130' INT

# Call main
main "${@}"

# EOF
